[Unit]
Description=بوت سيرفر LSPD
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=enclave
WorkingDirectory=/opt/enclave/lspd-welcome-bot
# ملف مستقل: بوت وسيرفر غير اللذين لـ Enclave، رغم تطابق أسماء المتغيرات
EnvironmentFile=/etc/enclave/lspd-bot.env
Environment=NODE_ENV=production
Environment=PORT=
Environment=XDG_CACHE_HOME=/var/cache/lspd-bot
ExecStart=/usr/bin/node bot.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CacheDirectory=lspd-bot

[Install]
WantedBy=multi-user.target
