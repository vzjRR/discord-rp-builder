[Unit]
Description=بوت لوقات سيرفر LSPD (نفس هوية بوت الترحيب — عملية منفصلة فقط)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=enclave
WorkingDirectory=/opt/enclave/logs-bot
# نفس ملف أسرار بوت الترحيب عمدًا: نفس التوكن ونفس GUILD_ID، فيظهر
# اللوق بهوية البوت نفسها ("EN | LSPD BOT#3043") بدل تطبيق ديسكورد ثانٍ
EnvironmentFile=/etc/enclave/lspd-bot.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node bot.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
