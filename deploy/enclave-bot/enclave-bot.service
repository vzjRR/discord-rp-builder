[Unit]
Description=بوت سيرفر Enclave (ترحيب + تتبّع)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=enclave
WorkingDirectory=/opt/enclave/welcome-bot
EnvironmentFile=/etc/enclave/enclave-bot.env
Environment=NODE_ENV=production
# الخطوط المدمجة لازمة لرسم الأسماء العربية والرموز في صورة الترحيب
Environment=FONTCONFIG_PATH=/opt/enclave/welcome-bot/assets/fonts
# PORT فارغ عمدًا: خادم الفحص الاختياري داخل البوت يلتقط أي منفذ يجده،
# فيزاحم المنصة على منفذها لو عملا على خادم واحد
Environment=PORT=
Environment=XDG_CACHE_HOME=/var/cache/enclave-bot
ExecStart=/usr/bin/node bot.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/data
# fonts.conf يضع كاش الخطوط داخل مجلد الخطوط، و/opt للقراءة فقط —
# بدون هذا يفشل بناء الكاش فتتدهور الأسماء العربية في الصورة
ReadWritePaths=/opt/enclave/welcome-bot/assets/fonts
# <cachedir> النسبي بـ fonts.conf يُحلّ بالنسبة لمجلد العمل (فوق assets/fonts
# بمستوى)، لا بالنسبة لمجلد fonts.conf نفسه — بدون هذا يفشل الكاش كل بدء تشغيل
# (غير خطير: يرجع لعدم وجود كاش دائم، بس أبطأ بإعادة تحليل الخطوط)
ReadWritePaths=/opt/enclave/welcome-bot/.fc-cache
CacheDirectory=enclave-bot

[Install]
WantedBy=multi-user.target
