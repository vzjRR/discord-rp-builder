# انسخ هذا الملف باسم .env محليًا فقط للتجربة — على Railway تُضبط هذي كلها
# من تبويب Variables بالسيرفس، مو بملف .env (الملف موجود بـ .gitignore أصلًا).

# نفس توكن بوت الديسكورد المستخدم بـ welcome-bot / logs-bot
DISCORD_TOKEN=

# نفس ID السيرفر (Server ID)
GUILD_ID=

# مسار ملف قاعدة بيانات SQLite — على Railway خليه فاضي (الافتراضي
# /data/admin.db يطابق الـ Volume المرفق بسيرفس welcome-bot). محليًا للتجربة
# فقط، تقدر تحطه مسار داخل المشروع بدل /data.
SQLITE_PATH=

# سر توقيع الكوكيز/الجلسات — أي نص عشوائي طويل (32+ حرف)، ولّده مرة وحطه
# ثابت (لو تغيّر تنقطع كل الجلسات المسجلة دخول)
SESSION_SECRET=

# الرقم السري لأول حساب Owner — يُستخدم مرة وحدة أول ما السيرفر يشتغل لإنشاء
# حساب المالك تلقائيًا (لو ما فيه حساب owner موجود بعد). بعدها تقدر تدخل
# بالمنصة نفسها وتسوي حسابات إضافية وتغيّر هذا الرقم أو تحذفه من المتغيرات.
OWNER_SETUP_PIN=
OWNER_SETUP_NAME=Owner

# وضع التجربة: لو معبّى بـ ID عضو، كل رسالة خاصة/إعلان يطلع من المنصة
# (حتى لو مستهدف الكل أو رول معين أو قناة) بيروح لهذا العضو فقط بدل الهدف
# الحقيقي. خليه فاضي بالإنتاج (هذا الوضع مطفّى حاليًا بالنشر الفعلي).
TEST_MODE_REDIRECT_USER_ID=

# ID حساب ديسكورد يوصله تنبيه خاص كل ما حد يطلب رمز دخول جديد من صفحة
# /request-access — عادةً ID المالك (Owner) نفسه.
OWNER_NOTIFY_USER_ID=1303195553068482591

# الرابط الرسمي للمنصة (بدون / بالنهاية) — يُستخدم بالروابط اللي ترسل
# للأعضاء بالرسائل الخاصة. لازم يُضبط لو الدومين يمر عبر Cloudflare مع
# إعادة كتابة الـ Host، وإلا بيطلع رابط Railway الخام بدل دومينك.
PUBLIC_BASE_URL=https://enclave-admin.tsh87.com

# سر مشترك بينك وبين Cloudflare — تضيفه Cloudflare لكل طلب بهيدر
# x-edge-secret عبر Transform Rule، والمنصة تتأكد منه. أي نص عشوائي طويل.
# هو اللي يثبت إن الطلب جا عبر Cloudflare فعلًا (ما نقدر نعتمد على الـ IP:
# قابل للتزوير من رابط الاستضافة الخام — شوف التعليق بـ src/clientIp.js).
CLOUDFLARE_SECRET=

# يرفض أي طلب ما جا عبر Cloudflare — يقفل رابط الاستضافة الخام تمامًا
# فما يقدر أحد يفتح المنصة منه أو يعرف وين مستضافة. يحتاج CLOUDFLARE_SECRET.
# ⚠️ فعّله (true) فقط بعد ما تتأكد إن الدومين شغّال عبر Cloudflare —
# لو فعّلته وإعداد Cloudflare مو تمام، بتنقفل المنصة عن الجميع.
REQUIRE_CLOUDFLARE=

# اختياري — البورت (Railway يعبيه تلقائيًا بنفسه)
PORT=3000

# اختياري — مسار ملف تعديلات الرسائل الثابتة (رسالة الترحيب/الخاص) اللي
# تُحفظ من صفحة "الرسائل الثابتة" بالمنصة. الافتراضي /data/message-templates.json
# (بنفس الـ Volume). لازم يطابق نفس المتغير بـ welcome-bot لو غيّرته هناك.
MESSAGE_TEMPLATES_PATH=

# اختياري — مسار ملف تعديل رسالة الترحيب بالمنصة (اللي تروح للأدمن الجديد).
# الافتراضي /data/onboarding-message.json
ONBOARDING_MESSAGE_PATH=
