{
  "name": "lspd-welcome-bot",
  "version": "1.0.0",
  "description": "Always-on bot: welcomes new members to the LSPD server. Deployed on Railway.",
  "main": "bot.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "cross-env FONTCONFIG_PATH=./assets/fonts node bot.js",
    "test:names": "cross-env FONTCONFIG_PATH=./assets/fonts node test-names.js",
    "test": "npm run test:names",
    "send-test": "cross-env FONTCONFIG_PATH=./assets/fonts node send-test-welcome.js"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "sharp": "^0.35.3"
  }
}
