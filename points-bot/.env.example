# توكن بوت Discord — نفس تطبيق Enclave (بوت 1535663542420643880) المستخدم
# بـ welcome-bot / logs-bot / admin-panel، لا تطبيق منفصل
DISCORD_TOKEN=

# القناة الوحيدة التي تُحتسب فيها الصور كنقاط — أي رسالة بأي قناة أخرى تُتجاهل تمامًا
IMAGE_POINTS_CHANNEL_ID=1535680167576608910

# مكان قاعدة بيانات النقاط. لو تركته فاضي وكان EVENTS_DB_PATH معرّف (نفس
# مجلد بيانات welcome-bot)، يُشتق منه تلقائيًا نفس المجلد + points.db
POINTS_DB_PATH=/data/points.db

# لو البوت ينشر بنفس السيرفر جنب welcome-bot، اترك POINTS_DB_PATH فاضي
# وعرّف هذا بدلًا منه — نفس القيمة المستخدمة بـ welcome-bot/.env
# EVENTS_DB_PATH=/data/server-events.db

# ملف السجل الدائم المشترك بين كل بوتات/خدمات enclave (logs-bot، admin-panel، هنا)
AUDIT_LOG_FILE_PATH=/var/log/enclave/audit.log

# التوقيت المستخدم لحساب حدود الأسبوع/الشهر (رولوفر)
TIMEZONE=Asia/Muscat

# اليوم اللي يبدأ فيه "الأسبوع" لأغراض لوحة الصدارة الأسبوعية
# القيم الممكنة: MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY, SUNDAY
WEEK_START_DAY=MONDAY

# حذف رسالة يخصم نقطتها دايمًا تلقائيًا (لا خيار تعطيل — رسالة انحذفت
# يعني الصورة ما عادت موجودة، فلا مبرر لبقاء نقطتها)

# هل يُعاد احتساب النقطة عند تعديل رسالة (انتقال 0<->N صور)؟ (افتراضيًا نعم)
ADJUST_POINTS_ON_MESSAGE_EDIT=true

# منفذ اختياري — عرّفه فقط لو تنشر على منصة PaaS تحتاج health-check HTTP (Railway/Render/Koyeb)
# اتركه فاضي على VPS عادي (systemd/pm2)
# PORT=3002
