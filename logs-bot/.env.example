# انسخ هذا الملف باسم .env واملأ القيم
# نفس التوكن ونفس السيرفر المستخدمين ببقية المشروع (نفس تطبيق Discord، عملية منفصلة فقط)

DISCORD_TOKEN=
GUILD_ID=

# اختياري: كل أنواع اللوق المفعّلة تُرسل لقناة واحدة بهذا الـ ID بدل البحث
# عن قناة باسمها لكل نوع (راجع config/logs.js). لو فاضي، يبحث بالاسم كالمعتاد.
LOG_CHANNEL_ID=

# اختياري: أنواع لوق تُعطَّل لهذه النشرة فقط (مفصولة بفاصلة)، بدون تعديل
# config/logs.js المشترك. مثال: LOG_DISABLE_TYPES=bot,ticket,report
LOG_DISABLE_TYPES=

# اختياري: مسار ملف السجل الدائم على القرص — كل حدث لوق يُكتب هنا سطر JSON
# واحد، بغض النظر عن نجاح الإرسال لديسكورد أو وجود القناة أصلًا. الافتراضي
# /var/log/enclave/audit.log — لازم المستخدم اللي يشغّل البوت يملك صلاحية
# كتابة على المجلد (mkdir -p ثم chown)، ولازم ReadWritePaths بملف الخدمة
# يشمله لو ProtectSystem=strict مفعّل.
AUDIT_LOG_FILE_PATH=
