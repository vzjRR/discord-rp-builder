{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd welcome-bot && npm install && cd ../admin-panel && npm install"
  },
  "deploy": {
    "startCommand": "bash start-merged.sh",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
