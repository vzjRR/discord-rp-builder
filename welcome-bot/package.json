{
  "name": "enclave-welcome-bot",
  "version": "1.0.0",
  "description": "بوت مستقل: يرحّب بالأعضاء الجدد (رسالة + صورة مولّدة تلقائيًا + رول تلقائي + DM اختياري)",
  "main": "bot.js",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "start": "cross-env FONTCONFIG_PATH=./assets/fonts node bot.js",
    "test:image": "cross-env FONTCONFIG_PATH=./assets/fonts node test-welcome.js",
    "test:names": "cross-env FONTCONFIG_PATH=./assets/fonts node test-names.js",
    "test:templates": "node test-templates.js",
    "test": "npm run test:names && npm run test:templates",
    "dry-run": "cross-env FONTCONFIG_PATH=./assets/fonts node dry-run-join.js",
    "send-test": "cross-env FONTCONFIG_PATH=./assets/fonts node send-test-welcome.js"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "sharp": "^0.35.3"
  }
}
